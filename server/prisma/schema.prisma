// Prisma schema — Aktivite Giriş Sistemi
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  fullname          String
  passwordHash      String
  role              String   @default("user") // admin | py | user
  phone             String?  @unique // E.164 format (+905551234567) — WhatsApp bot için
  defaultActivityId Int? // Yeni kayıt eklerken varsayılan olarak seçilir (Expert vb.)
  // Kullanıcının bağlı olduğu şirket (yüklenici). Komisyon hesabında kritik:
  // kaydı giren kişinin şirketi müşterinin yüklenicisiyle aynıysa komisyon uygulanmaz.
  contractorId      Int?
  createdAt         DateTime @default(now())

  entries         Entry[]
  wpMessages      WhatsAppMessage[]
  projectRoles    ProjectMember[]
  scopes          UserContractor[]
  defaultActivity Activity?         @relation(fields: [defaultActivityId], references: [id], onDelete: SetNull)
  contractor      Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
}

// Görünürlük kapsamı — bir kullanıcı BİRDEN FAZLA yükleniciden sorumlu olabilir.
// Admin/PY yalnızca kapsamındaki yüklenicilere ait müşterilerin kayıtlarını görür.
// DİKKAT: bu KOMİSYONU ETKİLEMEZ; komisyon User.contractorId (çalıştığı şirket) ile
// hesaplanır. Aksi halde TDEV'li birine SALDO kapsamı verince komisyon sıfırlanırdı.
model UserContractor {
  id           Int @id @default(autoincrement())
  userId       Int
  contractorId Int

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([userId, contractorId])
  @@index([userId])
}

// Proje bazlı rol: kullanıcı normalde Expert olsa da belirli bir projede
// Senior olarak tanımlanabilir. Kayıt girerken bu proje için tanım varsa o rol,
// yoksa kullanıcının varsayılan rolü kullanılır.
model ProjectMember {
  id         Int @id @default(autoincrement())
  projectId  Int
  userId     Int
  activityId Int // bu projedeki rolü (Junior/Mid/Senior/Expert)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Activity {
  id     Int     @id @default(autoincrement())
  name   String
  unit   String // saat | gün
  desc   String?
  active Boolean @default(true) // pasife çekilince yeni kayıtta seçilemez, geçmiş korunur

  rates           ProjectRate[]
  entries         Entry[]
  defaultForUsers User[]
  projectRoles    ProjectMember[]
}

model Contractor {
  id       Int     @id @default(autoincrement())
  name     String
  contact  String?
  phone    String?
  email    String?
  address  String?
  discount Float   @default(0)

  customers Customer[]
  users     User[]
  scopedTo  UserContractor[]
}

model Customer {
  id           Int     @id @default(autoincrement())
  name         String
  contractorId Int
  contact      String?
  phone        String?
  currency     String  @default("TRY") // TRY | USD | EUR — fiyatların para birimi
  active       Boolean @default(true) // pasife çekilince yeni kayıtta seçilemez, geçmiş korunur

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projects   Project[]
  entries    Entry[]
}

// Proje — bir müşterinin altında. Rate'ler proje seviyesinde tutulur
// (aynı müşterinin farklı ratelerde projeleri olabilir).
model Project {
  id         Int      @id @default(autoincrement())
  customerId Int
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rates    ProjectRate[]
  entries  Entry[]
  members  ProjectMember[]

  @@index([customerId])
}

// Tarih-bazlı rate: aynı proje+aktivite için birden çok dönem olabilir.
// effectiveTo null = sonsuz (açık dönem). Bir kayda uygulanacak rate,
// kaydın tarihini kapsayan dönemdir.
model ProjectRate {
  id            Int     @id @default(autoincrement())
  projectId     Int
  activityId    Int
  rate          Float
  effectiveFrom String  @default("2000-01-01") // YYYY-MM-DD, dahil
  effectiveTo   String? // YYYY-MM-DD, dahil; null = sonsuz

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([projectId, activityId])
}

model Entry {
  id         Int      @id @default(autoincrement())
  date       String // YYYY-MM-DD
  qty        Float
  ticketId   String? // Müşteri talep/ticket ID (örn. JIRA-1234, ZBT-5678)
  note       String?
  customerId Int // = project.customerId (gruplamada kolaylık için tutuluyor)
  projectId  Int? // proje seviyesi — migration sonrası tüm kayıtlarda dolu
  activityId Int
  userId     Int
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([customerId])
  @@index([projectId])
  @@index([userId])
  @@index([userId, date])
}

// WhatsApp konuşma tarihçesi — LLM'in çok-turlu diyalog yapabilmesi için
// son birkaç mesajı bağlam olarak kullanır. Eski kayıtlar periyodik temizlenir.
model WhatsAppMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String // 'user' | 'bot'
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Dönem kilidi — mutabakat gönderilen aylar kilitlenir.
// Kilitli döneme kayıt eklenemez/değiştirilemez/silinemez (WhatsApp dahil).
// Yönetici kilidi açabilir; kilitle/aç işlemleri audit'e düşer.
model PeriodLock {
  id        Int      @id @default(autoincrement())
  period    String   @unique // YYYY-MM
  lockedBy  String? // kilitleyen kullanıcı (snapshot)
  createdAt DateTime @default(now())
}

// Önemli aksiyonların izi — kim ne zaman ne yaptı.
// Sadece admin'in görebileceği bir sayfada listelenir.
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int? // null olabilir (örn. login fail vakalarında)
  username  String? // user silinse bile iz kalsın diye snapshot
  action    String // create | update | delete | login | login_fail
  target    String // entry | user | customer | contractor | activity | session
  targetId  Int?
  summary   String? // İnsan-okur özet ("Müşteri 'Beymen' güncellendi")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([target])
}
